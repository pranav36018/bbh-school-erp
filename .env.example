# ==========================================
# INDIA UNIFIED SCHOOL ERP - ENVIRONMENT CONFIG
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="India Unified School ERP"

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/school_erp?schema=public
# For hosted cloud PostgreSQL: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="unified-school-erp-super-secure-jwt-key-2026-production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="unified-school-erp-secure-cookie-secret-key-32chars"

# Super Admin / Platform Owner Seed Credentials
PLATFORM_OWNER_EMAIL="superadmin@indiaunifiederp.edu.in"
PLATFORM_OWNER_PASSWORD="PlatformOwner@2026!"

# Indian Payment Gateway (Razorpay simulation or live keys)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
ENABLE_UPI_PAYMENT="true"

# Messaging Gateways (Configurable Email / SMS / WhatsApp)
SMS_PROVIDER="mock" # mock | msg91 | fast2sms | twilio
WHATSAPP_PROVIDER="mock" # mock | gupshup | meta
EMAIL_PROVIDER="mock" # mock | resend | ses | smtp
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@indiaunifiederp.edu.in"

# AI Automation Configuration
AI_PROVIDER="mock" # mock | gemini | openai
AI_API_KEY=""

# Document Storage (Local or S3 compatible)
STORAGE_TYPE="local" # local | s3
S3_BUCKET_NAME=""
S3_REGION="ap-south-1" # Mumbai region
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
